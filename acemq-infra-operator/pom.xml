<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.acemq</groupId>
    <artifactId>acemq-infra-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>acemq-infra-operator</artifactId>
  <packaging>jar</packaging>

  <name>AceMQ Infrastructure Operator</name>
  <description>Phase 5: the same cutover as acemq-infra apply and rollback, driven from a Cutover
    custom resource. The plan goes into status, a human approves it by name, and a controller
    restart never resumes a started step.</description>

  <properties>
    <!-- Shipped as a container image built from this module, not as a Maven
         coordinate: nobody embeds an operator. -->
    <maven.deploy.skip>true</maven.deploy.skip>

    <!-- Java Operator SDK 5 is Java 17, which is this repository's baseline,
         and it pins the fabric8 client it is built and tested against. The mock
         server is taken at that same version rather than the newest fabric8,
         so that the client the tests talk through is the one that ships. -->
    <josdk.version>5.6.2</josdk.version>
    <fabric8.version>7.9.0</fabric8.version>
    <slf4j.version>2.0.17</slf4j.version>
  </properties>

  <dependencies>
    <!-- The CLI itself, not a copy of its logic. apply and rollback run through
         Cli.run, so the operator's refusals, gates and journal are the CLI's
         by construction rather than by keeping two things in step. -->
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-infra-cli</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.javaoperatorsdk</groupId>
      <artifactId>operator-framework</artifactId>
      <version>${josdk.version}</version>
    </dependency>
    <!-- Read by the CRD generator at build time and by nothing at run time. -->
    <dependency>
      <groupId>io.fabric8</groupId>
      <artifactId>generator-annotations</artifactId>
      <version>${fabric8.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>io.fabric8</groupId>
      <artifactId>kubernetes-server-mock</artifactId>
      <version>${fabric8.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The CRD is generated from the Java model, so the schema and the class
           cannot disagree; CrdTest then holds deploy/crd.yaml, the file people
           apply, to the generated one. -->
      <plugin>
        <groupId>io.fabric8</groupId>
        <artifactId>crd-generator-maven-plugin</artifactId>
        <version>${fabric8.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.acemq.infra.operator.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.10.0</version>
        <executions>
          <execution>
            <id>runtime-classpath</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
